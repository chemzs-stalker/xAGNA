--- xagna_mcm: the MCM log-level control and the config reader.

local RegisterScriptCallback = RegisterScriptCallback

local function get_config(key)
    if not ui_mcm then return nil end
    return ui_mcm.get("xagna/" .. key)
end

local function apply_log_level()
    local name = get_config("xagna_logging/log_level") or "WARN"
    xagna_log.set_log_level(name)
    xagna_log.log_warn("log level = %s", name)
end

local function apply_sampler()
    xagna_log.set_sampler_enabled(get_config("xagna_logging/sampler") and true or false)
end

local function apply_log_flush()
    xagna_log.set_log_flush(get_config("xagna_logging/log_flush") and true or false)
end

--- Behavior chances, read live by the consumers. 0 on a slider disables that behavior.
function get_hello_chance()        return get_config("xagna_behavior/hello_approach") or 50 end
function get_pda_approach_chance()  return get_config("xagna_behavior/pda_approach")  or 15 end
function get_pda_commander_chance() return get_config("xagna_behavior/pda_commander") or 15 end
function get_pda_idle_chance()      return get_config("xagna_behavior/pda_idle")      or 15 end
function is_wounded_standup()
    local v = get_config("xagna_behavior/wounded_standup")
    if v == nil then return true end
    return v
end
function get_relaxed_idle_mode() return get_config("xagna_behavior/relaxed_idle") or "2" end

--- Logs every MCM setting at INFO on load, as the sibling mods do, so a log names the live config.
local function log_mcm_settings()
    xagna_log.log_info("[mcm] hello=%s approach=%s commander=%s idle=%s wounded=%s relaxed=%s level=%s flush=%s sampler=%s",
        tostring(get_hello_chance()), tostring(get_pda_approach_chance()), tostring(get_pda_commander_chance()),
        tostring(get_pda_idle_chance()), tostring(is_wounded_standup()), tostring(get_relaxed_idle_mode()),
        tostring(get_config("xagna_logging/log_level")), tostring(get_config("xagna_logging/log_flush")),
        tostring(get_config("xagna_logging/sampler")))
end

function on_mcm_load()
    return {
        id = "xagna",
        gr = {
            {
                id = "xagna_behavior",
                sh = true,
                gr = {
                    { id = "hello_approach",  type = "track", val = 2, min = 0, max = 100, step = 5, def = 50, hint = "xagna_hello_approach" },
                    { id = "pda_approach",    type = "track", val = 2, min = 0, max = 100, step = 5, def = 15, hint = "xagna_pda_approach" },
                    { id = "pda_commander",   type = "track", val = 2, min = 0, max = 100, step = 5, def = 15, hint = "xagna_pda_commander" },
                    { id = "pda_idle",        type = "track", val = 2, min = 0, max = 100, step = 5, def = 15, hint = "xagna_pda_idle" },
                    { id = "wounded_standup", type = "check", val = 1, def = true, hint = "xagna_wounded_standup" },
                    { id = "relaxed_idle", type = "list", val = 0, def = "2", hint = "xagna_relaxed_idle",
                        content = {
                            { "0", "player" },
                            { "1", "own" },
                            { "2", "varied" },
                        },
                    },
                },
            },
            {
                id = "xagna_logging",
                sh = true,
                gr = {
                    { id = "log_level", type = "list", val = 0, def = "WARN", hint = "xagna_log_level",
                        content = {
                            { "ERROR", "error" },
                            { "WARN", "warn" },
                            { "INFO", "info" },
                            { "DEBUG", "debug" },
                        },
                    },
                    { id = "log_flush", type = "check", val = 1, def = false, hint = "xagna_log_flush" },
                    { id = "sampler", type = "check", val = 1, def = false, hint = "xagna_sampler" },
                },
            },
        },
    }
end

function on_game_start()
    apply_log_level()
    apply_sampler()
    apply_log_flush()
    RegisterScriptCallback("on_option_change", apply_log_level)
    RegisterScriptCallback("on_option_change", apply_sampler)
    RegisterScriptCallback("on_option_change", apply_log_flush)
    RegisterScriptCallback("mcm_option_restore_default", apply_log_level)
    RegisterScriptCallback("mcm_option_restore_default", apply_sampler)
    RegisterScriptCallback("mcm_option_restore_default", apply_log_flush)
    RegisterScriptCallback("actor_on_first_update", log_mcm_settings)
end
