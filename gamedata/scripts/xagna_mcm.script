--- xagna_mcm: the MCM log-level control and the config reader.

local RegisterScriptCallback = RegisterScriptCallback

local function get_config(key)
    if not ui_mcm then return nil end
    return ui_mcm.get("xagna/" .. key)
end

local function apply_log_level()
    local name = get_config("log_level") or "WARN"
    xagna_log.set_log_level(name)
    xagna_log.log_warn("log level = %s", name)
end

function on_mcm_load()
    return {
        id = "xagna",
        sh = true,
        gr = {
            { id = "log_level_desc", type = "desc", text = "ui_mcm_xagna_log_level_desc" },
            { id = "log_level", type = "list", val = 0, def = "WARN",
                content = {
                    { "ERROR", "error" },
                    { "WARN", "warn" },
                    { "INFO", "info" },
                    { "DEBUG", "debug" },
                },
            },
        },
    }
end

function on_game_start()
    apply_log_level()
    RegisterScriptCallback("on_option_change", apply_log_level)
    RegisterScriptCallback("mcm_option_restore_default", apply_log_level)
end
