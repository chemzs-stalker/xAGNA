--- xagna_core: data for the additive companion -- kept animation entries, PDA into-patches, and standing-posture deltas.

local PROP_ONESHOT = { maxidle = 1, sumidle = 1, rnd = 100 }
local PROP_WOUNDED = { maxidle = 5, sumidle = 10, rnd = 70 }
local PROP_PUNCH   = { maxidle = 5, sumidle = 2, rnd = 100 }
local PROP_IDLE    = { maxidle = 5, sumidle = 3, rnd = 80 }

local PDA_DRAW = { "norm_torso_pda_draw_1", "norm_torso_pda_idle_1", "norm_torso_pda_holster_1" }

-- Slot-0 into pieces the approach gate composes: beckon greeting, PDA draw-hold-holster, lone detach.
local BECKON  = { "norm_torso_0_gest_beckoning_1", "idle_0_idle_0" }
local PDA_SEQ = { { a = "device_pda" }, PDA_DRAW[1], PDA_DRAW[2], PDA_DRAW[3], { d = "device_pda" } }
local DETACH  = { { d = "device_pda" } }

local function _build_list(a, b)
    local result = {}
    for i = 1, #a do result[#result + 1] = a[i] end
    for i = 1, #b do result[#result + 1] = b[i] end
    return result
end

local function build_punch_slot(index)
    return { "free_facer_" .. index, { f = xr_effects.actor_punch }, "free_facer_" .. index, { f = xr_effects.clearAbuse } }
end

-- Sentry idle: slots 1/2/4/8/9 play the chasovoy look-around set, the rest a plain idle.
local IDLE_CHASOVOY = {
    prop = PROP_IDLE,
    into = nil,
    out  = nil,
    idle = {
        [0] = "idle_0_idle_1", [1] = "idle_1_idle_1", [2] = "idle_2_idle_1", [3] = "idle_3_idle_1",
        [4] = "idle_4_idle_1", [8] = "idle_8_idle_1", [9] = "idle_9_idle_1", [10] = "idle_10_idle_0",
    },
    rnd = {
        [0]  = { "idle_0_idle_1", "idle_0_idle_1", "idle_0_idle_1", "idle_0_idle_1", "idle_0_idle_1" },
        [1]  = { "chasovoy_0", "chasovoy_1", "chasovoy_2", "chasovoy_3", "chasovoy_4" },
        [2]  = { "chasovoy_0", "chasovoy_1", "chasovoy_2", "chasovoy_3", "chasovoy_4" },
        [3]  = { "idle_3_idle_0", "idle_3_idle_0", "idle_3_idle_0", "idle_3_idle_0", "idle_3_idle_0" },
        [4]  = { "chasovoy_0", "chasovoy_1", "chasovoy_2", "chasovoy_3", "chasovoy_4" },
        [8]  = { "chasovoy_0", "chasovoy_1", "chasovoy_2", "chasovoy_3", "chasovoy_4" },
        [9]  = { "chasovoy_0", "chasovoy_1", "chasovoy_2", "chasovoy_3", "chasovoy_4" },
        [10] = { "idle_10_idle_0", "idle_10_idle_0", "idle_10_idle_0", "idle_10_idle_0", "idle_10_idle_0" },
    },
}

-- Listening/caution: slots 3 and 10 fall back to a plain idle, the rest play the prisluh set.
local CAUTION = {
    prop = PROP_IDLE,
    into = {
        [0] = { "prisluh_0_in" }, [1] = { "prisluh_1_in" }, [2] = { "prisluh_2_in" }, [3] = { "idle_3_idle_0" },
        [4] = { "prisluh_4_in" }, [8] = { "prisluh_8_in" }, [9] = { "prisluh_9_in" }, [10] = { "idle_10_idle_0" },
    },
    out = {
        [0] = { "prisluh_0_out" }, [1] = { "prisluh_1_out" }, [2] = { "prisluh_2_out" }, [3] = { "idle_3_idle_0" },
        [4] = { "prisluh_4_out" }, [8] = { "prisluh_8_out" }, [9] = { "prisluh_9_out" }, [10] = { "idle_10_idle_0" },
    },
    idle = {
        [0] = "prisluh_0_1", [1] = "prisluh_1_1", [2] = "prisluh_2_1", [3] = "idle_3_idle_0",
        [4] = "prisluh_4_1", [8] = "prisluh_8_1", [9] = "prisluh_9_1", [10] = "idle_10_idle_0",
    },
    rnd = {
        [0] = { "prisluh_0_0", "prisluh_0_2" }, [1] = { "prisluh_1_0", "prisluh_1_2" },
        [2] = { "prisluh_2_0", "prisluh_2_2" }, [3] = { "idle_3_idle_0", "idle_3_idle_0" },
        [4] = { "prisluh_4_0", "prisluh_4_2" }, [8] = { "prisluh_8_0", "prisluh_8_2" },
        [9] = { "prisluh_9_0", "prisluh_9_2" }, [10] = { "idle_10_idle_0", "idle_10_idle_0" },
    },
}

--- Whole animation-list entries kept from xAGNA (swaps that change the motion, not the action).
--- @cost O(1); builds and returns a literal table
function get_keep_entries()
    local uni_medkit = {
        prop = PROP_ONESHOT,
        into = { [0] = { "uni_anim_in", { a = "medkit_script" }, "uni_anim_b", { f = xr_help_wounded.help_wounded } } },
        out  = { [0] = { "uni_anim_out", { d = "medkit_script" } } },
        idle = nil,
        rnd  = nil,
    }
    return {
        punch = {
            prop = PROP_PUNCH,
            into = {
                [0]  = build_punch_slot(0),
                [1]  = build_punch_slot(1),
                [2]  = build_punch_slot(2),
                [3]  = build_punch_slot(3),
                [4]  = build_punch_slot(4),
                [8]  = build_punch_slot(8),
                [9]  = build_punch_slot(9),
                [10] = build_punch_slot(10),
            },
            out  = nil,
            idle = nil,
            rnd  = nil,
        },
        cr_medical_1 = uni_medkit,
        cr_medical_2 = uni_medkit,
        help_wounded = uni_medkit,
        pickup_crouch = {
            prop = PROP_ONESHOT,
            into = { [0] = { "uni_anim_in", "uni_anim_a", { f = xr_gather_items.gather_item } } },
            out  = { [0] = { "uni_anim_out" } },
            idle = nil,
            rnd  = nil,
        },
        search_corpse = {
            prop = PROP_ONESHOT,
            into = { [0] = { "uni_anim_in", "uni_anim_a", "uni_anim_out", { f = xr_corpse_detection.get_all_from_corpse } } },
            out  = nil,
            rnd  = nil,
            idle = nil,
        },
        field_dress = {
            prop = PROP_ONESHOT,
            into = { [0] = { "uni_anim_in", { a = "anim_knife" }, "uni_anim_a", { f = xr_corpse_detection.get_all_from_corpse } } },
            out  = { [0] = { "uni_anim_out", { d = "anim_knife" } } },
            idle = nil,
            rnd  = nil,
        },
        light_campfire = {
            prop = PROP_ONESHOT,
            into = { [0] = { "uni_anim_in", "uni_anim_b", "uni_anim_out", { f = axr_turn_on_campfire.light_campfire } } },
            out  = nil,
            rnd  = nil,
            idle = nil,
        },
        wounded_heavy_1 = {
            prop = PROP_WOUNDED,
            into = { [0] = { "idle_to_wounded_0_new" } },
            out  = { [0] = { "wounded_to_idle_0_new" } },
            idle = { [0] = "wounded_idle_0_new" },
            rnd  = nil,
        },
        bloodsucker_search = {
            prop = { maxidle = 0, sumidle = 0, rnd = 100 },
            into = {
                [1] = { "prisluh_1_idle_2" }, [2] = { "spetsnaz_4" }, [3] = { "prisluh_3_idle_0" }, [4] = { "prisluh_4_idle_0" },
                [8] = { "norm_alert_in_0" }, [9] = { "prisluh_3_idle_0" }, [10] = { "spetsnaz_4" },
            },
            idle = { [1] = "prisluh_1_idle_1", [2] = "spetsnaz_4", [3] = "prisluh_3_idle_2", [4] = "prisluh_4_idle_4", [8] = "norm_alert_idle_0", [9] = "prisluh_3_idle_3", [10] = "spetsnaz_4" },
            rnd  = { [2] = { "spetsnaz_4", "spetsnaz_5", "spetsnaz_6" }, [8] = { "norm_alert_idle_0", "norm_alert_idle_1", "norm_alert_idle_3" } },
            out  = {
                [1] = { "prisluh_1_idle_4" }, [2] = { "spetsnaz_7" }, [3] = { "prisluh_3_idle_5" }, [4] = { "prisluh_4_idle_5" },
                [8] = { "norm_alert_out_0" }, [9] = { "prisluh_3_idle_5" }, [10] = { "spetsnaz_7" },
            },
        },
        idle_chasovoy = IDLE_CHASOVOY,
        caution = CAUTION,
        xagna_use_pda = {
            prop = PROP_ONESHOT,
            into = { [0] = { { a = "device_pda" }, PDA_DRAW[1] } },
            idle = { [0] = PDA_DRAW[2] },
            out  = { [0] = { PDA_DRAW[3], { d = "device_pda" } } },
            rnd  = nil,
        },
    }
end

--- PDA-draw variant specs, each a vanilla base state plus a composed slot-0 into.
--- zzz builds the live copies, leaving each base entry idle and rnd intact.
--- @cost O(1); builds and returns a literal table
function get_pda_variants()
    return {
        { name = "xagna_talk_h",   base = "talk_default", into0 = BECKON,                  out0 = nil },
        { name = "xagna_talk_p",   base = "talk_default", into0 = PDA_SEQ,                  out0 = DETACH },
        { name = "xagna_talk_hp",  base = "talk_default", into0 = _build_list(BECKON, PDA_SEQ), out0 = DETACH },
        { name = "xagna_choose_p", base = "choose",       into0 = PDA_SEQ,                  out0 = DETACH },
    }
end

--- Standing-posture deltas for the states whose motion is a kept standing swap.
--- @cost O(1); builds and returns a literal table
function get_posture_deltas()
    local upright = { mental = anim.free, bodystate = move.standing }
    local upright_strapped = { weapon = "strapped", mental = anim.free, bodystate = move.standing }
    local upright_armed = { weapon = "unstrapped", mental = anim.free, bodystate = move.standing }
    return {
        search_corpse  = upright,
        help_wounded   = upright,
        field_dress    = upright,
        help_victim_1  = upright,
        light_campfire = upright,
        pickup_crouch  = upright,
        help_victim_2  = upright_strapped,
        wounded         = upright_armed,
        wounded_heavy   = upright_armed,
        wounded_heavy_2 = upright_armed,
        wounded_zombie  = upright_armed,
    }
end

--- New full-body states this mod adds (not vanilla): the standing PDA-use state the idle scheme drives.
--- @cost O(1); builds and returns a literal table
function get_added_states()
    return {
        xagna_use_pda = {
            weapon    = "strapped",
            movement  = move.stand,
            mental    = anim.free,
            bodystate = move.standing,
            animstate = nil,
            direction = nil,
            animation = "xagna_use_pda",
        },
    }
end
