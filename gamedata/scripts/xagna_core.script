--- xagna_core: data for the additive companion -- kept animation entries, PDA into-patches, and standing-posture deltas.

local getFS, io, os, pcall, string, table = getFS, io, os, pcall, string, table

local PROP_ONESHOT = { maxidle = 1, sumidle = 1, rnd = 100 }
local PROP_WOUNDED = { maxidle = 5, sumidle = 10, rnd = 70 }
local PROP_PUNCH   = { maxidle = 5, sumidle = 2, rnd = 100 }

local PDA_DRAW = { "norm_torso_pda_draw_1", "norm_torso_pda_idle_1", "norm_torso_pda_holster_1" }

local function punch_slot(index)
    return { "free_facer_" .. index, { f = xr_effects.actor_punch }, "free_facer_" .. index, { f = xr_effects.clearAbuse } }
end

local LEVELS = { ERROR = 2, WARN = 3, INFO = 4, DEBUG = 5 }
local log_level = LEVELS.WARN
local buffer = {}
local log_path
local log_started = false

--- Sets the log threshold from a level name; an unknown name falls back to WARN.
function set_log_level(name)
    log_level = LEVELS[name] or LEVELS.WARN
end

--- True when the log level is DEBUG, so callers skip building trace strings when tracing is off.
function is_debug()
    return log_level >= LEVELS.DEBUG
end

local function get_log_path()
    if not log_path then
        log_path = getFS():update_path("$logs$", "") .. "xagna.log"
    end
    return log_path
end

--- Writes the buffered lines to xagna.log in one open, then clears the buffer.
function flush_log()
    if #buffer == 0 then return end
    local file = io.open(get_log_path(), log_started and "a" or "w")
    if not file then return end
    file:write(table.concat(buffer, "\n") .. "\n")
    file:flush()
    file:close()
    buffer = {}
    log_started = true
end

local function emit(level, label, fmt, ...)
    if level > log_level then return end
    local ok, msg = pcall(string.format, fmt, ...)
    buffer[#buffer + 1] = string.format("[%s][%s] %s", os.date("%H:%M:%S"), label, ok and msg or fmt)
    -- Flush on a warning or once the buffer fills, so a DEBUG trace flood cannot grow memory between flush points.
    if level <= LEVELS.WARN or #buffer >= 300 then flush_log() end
end

function log_warn(fmt, ...)
    emit(LEVELS.WARN, "WARN", fmt, ...)
end

function log_info(fmt, ...)
    emit(LEVELS.INFO, "INFO", fmt, ...)
end

function log_debug(fmt, ...)
    emit(LEVELS.DEBUG, "DEBUG", fmt, ...)
end

--- Whole animation-list entries kept verbatim from xAGNA (swaps that change the motion, not the action).
function get_keep_entries()
    local uni_medkit = {
        prop = PROP_ONESHOT,
        into = { [0] = { "uni_anim_in", { a = "medkit_script" }, "uni_anim_b", { f = xr_help_wounded.help_wounded } } },
        out  = { [0] = { "uni_anim_out", { d = "medkit_script" } } },
        idle = nil,
        rnd  = nil,
    }
    return {
        punch = {
            prop = PROP_PUNCH,
            into = {
                [0]  = punch_slot(0),
                [1]  = punch_slot(1),
                [2]  = punch_slot(2),
                [3]  = punch_slot(3),
                [4]  = punch_slot(4),
                [8]  = punch_slot(8),
                [9]  = punch_slot(9),
                [10] = punch_slot(10),
            },
            out  = nil,
            idle = nil,
            rnd  = nil,
        },
        cr_medical_1 = uni_medkit,
        cr_medical_2 = uni_medkit,
        help_wounded = uni_medkit,
        pickup_crouch = {
            prop = PROP_ONESHOT,
            into = { [0] = { "uni_anim_in", "uni_anim_a", { f = xr_gather_items.gather_item } } },
            out  = { [0] = { "uni_anim_out" } },
            idle = nil,
            rnd  = nil,
        },
        search_corpse = {
            prop = PROP_ONESHOT,
            into = { [0] = { "uni_anim_in", "uni_anim_a", "uni_anim_out", { f = xr_corpse_detection.get_all_from_corpse } } },
            out  = nil,
            rnd  = nil,
            idle = nil,
        },
        field_dress = {
            prop = PROP_ONESHOT,
            into = { [0] = { "uni_anim_in", { a = "anim_knife" }, "uni_anim_a", { f = xr_corpse_detection.get_all_from_corpse } } },
            out  = { [0] = { "uni_anim_out", { d = "anim_knife" } } },
            idle = nil,
            rnd  = nil,
        },
        light_campfire = {
            prop = PROP_ONESHOT,
            into = { [0] = { "uni_anim_in", "uni_anim_b", "uni_anim_out", { f = axr_turn_on_campfire.light_campfire } } },
            out  = nil,
            rnd  = nil,
            idle = nil,
        },
        wounded_heavy_1 = {
            prop = PROP_WOUNDED,
            into = { [0] = { "idle_to_wounded_0_new" } },
            out  = { [0] = { "wounded_to_idle_0_new" } },
            idle = { [0] = "wounded_idle_0_new" },
            rnd  = nil,
        },
        xagna_use_pda = {
            prop = PROP_ONESHOT,
            into = { [0] = { { a = "device_pda" }, PDA_DRAW[1] } },
            idle = { [0] = PDA_DRAW[2] },
            out  = { [0] = { PDA_DRAW[3], { d = "device_pda" } } },
            rnd  = nil,
        },
    }
end

--- Into/out overlays for states whose vanilla into was empty, so the PDA draw is added without wiping idle/rnd.
function get_into_patches()
    return {
        choosing = {
            into = { [0] = { { a = "device_pda" }, PDA_DRAW[1], PDA_DRAW[2], PDA_DRAW[3], { d = "device_pda" } } },
            out  = { [0] = { { d = "device_pda" } } },
        },
        talk_default = {
            into = {
                [0] = { "norm_torso_0_gest_beckoning_1", "idle_0_idle_0", { a = "device_pda" }, PDA_DRAW[1], PDA_DRAW[2], PDA_DRAW[3], { d = "device_pda" } },
                [2] = { "norm_talk_2_in_0" },
            },
            out = {
                [0] = { { d = "device_pda" } },
                [2] = { "norm_talk_2_out_0" },
            },
        },
    }
end

--- Standing-posture deltas for the states whose motion is a kept standing swap (free mental requires standing body).
function get_posture_deltas()
    local upright = { mental = anim.free, bodystate = move.standing }
    local upright_strapped = { weapon = "strapped", mental = anim.free, bodystate = move.standing }
    local upright_armed = { weapon = "unstrapped", mental = anim.free, bodystate = move.standing }
    return {
        search_corpse  = upright,
        help_wounded   = upright,
        field_dress    = upright,
        help_victim_1  = upright,
        light_campfire = upright,
        pickup_crouch  = upright,
        help_victim_2  = upright_strapped,
        wounded         = upright_armed,
        wounded_heavy   = upright_armed,
        wounded_heavy_2 = upright_armed,
        wounded_zombie  = upright_armed,
    }
end

--- New full-body states this mod adds (not vanilla): the standing PDA-use state the idle scheme drives.
function get_added_states()
    return {
        xagna_use_pda = {
            weapon    = "strapped",
            movement  = move.stand,
            mental    = anim.free,
            bodystate = move.standing,
            animstate = nil,
            direction = nil,
            animation = "xagna_use_pda",
        },
    }
end
