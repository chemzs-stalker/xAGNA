--- zzz_xagna_overrides: applies the xAGNA companion edits onto vanilla at game start.

local pairs, math_random, type, RegisterScriptCallback = pairs, math.random, type, RegisterScriptCallback

local WOUNDED_MEDKITS = { "medkit_script", "medkit", "medkit_army", "medkit_scientic" }
local _wounded_exit_wrapped = false

local CHOOSE_STATE = "choose"
local APPROACH_STATES = { [CHOOSE_STATE] = true, talk_default = true }
local _set_state_wrapped = false
local _approach_decided = {}
local _orig_set_state

local function apply_animation_edits()
    if not state_mgr_animation_list then
        xagna_log.log_warn("state_mgr_animation_list absent, animation edits skipped")
        return 0
    end
    local anims = state_mgr_animation_list.animations
    if not anims then
        xagna_log.log_warn("animation table absent, animation edits skipped")
        return 0
    end

    local count = 0
    for name, entry in pairs(xagna_core.get_keep_entries()) do
        anims[name] = entry
        xagna_log.log_debug("entry %s applied", name)
        count = count + 1
    end

    return count
end

--- Builds each PDA-draw variant as a copy of its vanilla base with the composed slot-0 into.
--- The shared base state stays vanilla, so the approach gate only overlays the PDA pose.
-- @novalidate(conventions.manual_copy, reason:"xagna ships standalone, no xlibs dependency")
local function apply_pda_variants()
    local states = state_lib and state_lib.states
    local anims = state_mgr_animation_list and state_mgr_animation_list.animations
    if not (states and anims) then
        xagna_log.log_warn("state_lib/animation table absent, PDA variants skipped")
        return 0
    end
    local count = 0
    for _, spec in pairs(xagna_core.get_pda_variants()) do
        local base_state = states[spec.base]
        local base_anim = base_state and anims[base_state.animation]
        if base_state and base_anim then
            local variant_anim = {}
            for k, v in pairs(base_anim) do variant_anim[k] = v end
            variant_anim.into = {}
            if base_anim.into then for k, v in pairs(base_anim.into) do variant_anim.into[k] = v end end
            variant_anim.out = {}
            if base_anim.out then for k, v in pairs(base_anim.out) do variant_anim.out[k] = v end end
            variant_anim.into[0] = spec.into0
            variant_anim.out[0] = spec.out0
            anims[spec.name] = variant_anim
            local variant_state = {}
            for k, v in pairs(base_state) do variant_state[k] = v end
            variant_state.animation = spec.name
            states[spec.name] = variant_state
            count = count + 1
            xagna_log.log_debug("pda variant %s built from %s", spec.name, spec.base)
        else
            xagna_log.log_warn("base state %s absent, PDA variant %s skipped", spec.base, spec.name)
        end
    end
    return count
end

local function _apply_posture(state, delta)
    if delta.weapon then state.weapon = delta.weapon end
    state.mental = delta.mental
    state.bodystate = delta.bodystate
end

local function apply_posture_edits()
    if not state_lib then
        xagna_log.log_warn("state_lib absent, posture edits skipped")
        return 0
    end
    local states = state_lib.states
    if not states then
        xagna_log.log_warn("state table absent, posture edits skipped")
        return 0
    end

    local count = 0
    for name, delta in pairs(xagna_core.get_posture_deltas()) do
        local state = states[name]
        if state then
            _apply_posture(state, delta)
            xagna_log.log_debug("posture %s applied", name)
            count = count + 1
        else
            xagna_log.log_warn("state %s absent, posture skipped", name)
        end
    end

    return count
end

local function apply_added_states()
    if not state_lib or not state_lib.states then
        xagna_log.log_warn("state_lib absent, added states skipped")
        return 0
    end
    local states = state_lib.states
    local count = 0
    for name, def in pairs(xagna_core.get_added_states()) do
        states[name] = def
        xagna_log.log_debug("state %s added", name)
        count = count + 1
    end
    return count
end

--- Restores the wounded stand-up animation on recovery, as an additive wrap of xr_wounded eat_medkit.
-- @novalidate(conventions.func_no_verb, reason:"eat_medkit overrides the vanilla Cwound_manager method; the name must match")
local function apply_wounded_exit()
    local cls = xr_wounded and xr_wounded.Cwound_manager
    if not (cls and cls.eat_medkit) then
        xagna_log.log_warn("xr_wounded.Cwound_manager.eat_medkit absent, wounded-exit skipped")
        return
    end
    if _wounded_exit_wrapped then return end
    _wounded_exit_wrapped = true
    local orig = cls.eat_medkit
    cls.eat_medkit = function(self)
        if self.can_use_medkit ~= true or not xagna_mcm.is_wounded_standup() then
            return orig(self)
        end
        local npc = self.npc
        npc:set_health_ex(1)
        for i = 1, #WOUNDED_MEDKITS do
            local item = npc:object(WOUNDED_MEDKITS[i])
            if item then alife_release_id(item:id()) break end
        end
        local begin_wounded = load_var(npc, "begin_wounded")
        if begin_wounded ~= nil and time_global() - begin_wounded <= 60000 then
            xr_sound.set_sound_play(npc:id(), "help_thanks")
        end
        save_var(npc, "begin_wounded", nil)
        self.can_use_medkit = false
        db.storage[npc:id()].wounded_already_selected = nil
        state_mgr.set_state(npc, "idle")
        if xagna_log.is_debug() then xagna_log.log_debug("[wounded] id=%d heal-exit stand-up", npc:id()) end
        return true
    end
    if xagna_log.is_debug() then xagna_log.log_debug("[wounded] eat_medkit wrapped") end
end

--- Selects which PDA variant a fresh approach shows, hello and PDA rolling independently.
--- The choose state rolls the commander chance; returns false for the plain greet or a variant name.
local function _select_approach(state_name)
    if state_name == CHOOSE_STATE then
        if math_random(100) <= xagna_mcm.get_pda_commander_chance() then return "xagna_choose_p" end
        return false
    end
    local hello = math_random(100) <= xagna_mcm.get_hello_chance()
    local pda = math_random(100) <= xagna_mcm.get_pda_approach_chance()
    if hello and pda then return "xagna_talk_hp" end
    if hello then return "xagna_talk_h" end
    if pda then return "xagna_talk_p" end
    return false
end

--- Latches the approach decision per NPC, so meet re-setting the state does not re-roll or flicker.
--- The latch clears when the NPC leaves to any other state.
local function _get_approach(npc, state_name)
    local id = npc:id()
    local decided = _approach_decided[id]
    if decided == nil then
        decided = _select_approach(state_name)
        _approach_decided[id] = decided
        if xagna_log.is_debug() then
            xagna_log.log_debug("[overlay] id=%d %s -> %s", id, state_name, decided or "vanilla")
        end
    end
    return decided
end

--- The gated set_state: an approach state routes through the latched decision, everything else passes.
local function _set_state_gated(npc, state_name, callback, timeout_ms, target, extra)
    if npc and APPROACH_STATES[state_name] then
        local decided = _get_approach(npc, state_name)
        if decided then
            return _orig_set_state(npc, decided, callback, timeout_ms, target, extra)
        end
    elseif npc and state_name then
        _approach_decided[npc:id()] = nil
    end
    return _orig_set_state(npc, state_name, callback, timeout_ms, target, extra)
end

local function apply_approach_gate()
    if _set_state_wrapped then return end
    if not (state_mgr and state_mgr.set_state) then
        xagna_log.log_warn("state_mgr.set_state absent, approach gate skipped")
        return
    end
    _set_state_wrapped = true
    _orig_set_state = state_mgr.set_state
    state_mgr.set_state = _set_state_gated
    if xagna_log.is_debug() then xagna_log.log_debug("[overlay] approach gate wrapped") end
end

--- Sets the demonized npc_relaxed_idle_mode cvar from the MCM list.
--- Probed, so an older exe without the cvar stays inert and the compatibility floor does not move.
local function apply_relaxed_idle_cvar()
    local console = get_console()
    local present = console and type(console.get_string) == "function"
        and console:get_string("npc_relaxed_idle_mode") ~= nil
    if not present then
        xagna_log.log_warn("npc_relaxed_idle_mode absent (needs latest demonized), relaxed-idle mode skipped")
        return
    end
    local mode = xagna_mcm.get_relaxed_idle_mode()
    console:execute("npc_relaxed_idle_mode " .. mode)
    xagna_log.log_info("npc_relaxed_idle_mode set to %s", mode)
end

function on_game_start()
    local animations = apply_animation_edits()
    local postures = apply_posture_edits()
    local added = apply_added_states()
    local variants = apply_pda_variants()
    apply_wounded_exit()
    apply_approach_gate()
    apply_relaxed_idle_cvar()
    RegisterScriptCallback("on_option_change", apply_relaxed_idle_cvar)
    xagna_log.log_info("game start: %s animation entries, %s postures, %s states, %s pda variants applied",
        animations, postures, added, variants)
    xagna_log.flush_log()
end
