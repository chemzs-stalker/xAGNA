--- xagna_log: leveled logger for the xAGNA scripts; buffers to xagna.log and flushes on a cadence.

local getFS, io, os, pcall, string, table = getFS, io, os, pcall, string, table
local RegisterScriptCallback = RegisterScriptCallback

local FLUSH_PERIOD_SEC = 60
local LEVELS = { ERROR = 2, WARN = 3, INFO = 4, DEBUG = 5 }
local log_level = LEVELS.WARN
local buffer = {}
local log_path
local log_started = false
local last_body, last_level, last_label
local repeat_count = 0

--- Sets the log threshold from a level name; an unknown name falls back to WARN.
function set_log_level(name)
    log_level = LEVELS[name] or LEVELS.WARN
end

--- True when the log level is DEBUG, so callers skip building trace strings when tracing is off.
function is_debug()
    return log_level >= LEVELS.DEBUG
end

local function get_log_path()
    if not log_path then
        log_path = getFS():update_path("$logs$", "") .. "xagna.log"
    end
    return log_path
end

--- Collapses a run of identical consecutive lines into one ROW(N times) summary.
local function flush_repeat()
    if repeat_count == 0 then return end
    buffer[#buffer + 1] = string.format("[%s][%s] ROW(%d times)", os.date("%H:%M:%S"), last_label, repeat_count)
    repeat_count = 0
end

--- Writes the buffered lines to xagna.log in one open, then clears the buffer.
function flush_log()
    flush_repeat()
    if #buffer == 0 then return end
    local file = io.open(get_log_path(), log_started and "a" or "w")
    if not file then return end
    file:write(table.concat(buffer, "\n") .. "\n")
    file:flush()
    file:close()
    buffer = {}
    log_started = true
end

local function emit(level, label, fmt, ...)
    if level > log_level then return end
    local ok, msg = pcall(string.format, fmt, ...)
    local body = ok and msg or fmt
    if body == last_body and level == last_level then
        repeat_count = repeat_count + 1
        return
    end
    flush_repeat()
    last_body, last_level, last_label = body, level, label
    buffer[#buffer + 1] = string.format("[%s][%s] %s", os.date("%H:%M:%S"), label, body)
    if level <= LEVELS.WARN or #buffer >= 300 then flush_log() end
end

function log_warn(fmt, ...)
    emit(LEVELS.WARN, "WARN", fmt, ...)
end

function log_info(fmt, ...)
    emit(LEVELS.INFO, "INFO", fmt, ...)
end

function log_debug(fmt, ...)
    emit(LEVELS.DEBUG, "DEBUG", fmt, ...)
end

--- Re-arming flush timer: writes buffered lines to disk every FLUSH_PERIOD_SEC for live tailing.
local function flush_tick()
    ResetTimeEvent("xagna_log", "flush", FLUSH_PERIOD_SEC)
    flush_log()
end

local function start_flush_timer()
    RemoveTimeEvent("xagna_log", "flush")
    CreateTimeEvent("xagna_log", "flush", FLUSH_PERIOD_SEC, flush_tick)
end

function on_game_start()
    RegisterScriptCallback("save_state", flush_log)
    RegisterScriptCallback("on_before_level_changing", flush_log)
    RegisterScriptCallback("actor_on_first_update", start_flush_timer)
end
